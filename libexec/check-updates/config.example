# check-updates settings (zsh syntax). Uncomment to change a value.
# The daily check time is set with: check-updates schedule on HH:MM

# Terminal used to run updates: iTerm or Terminal (default: iTerm if installed)
# TERMINAL_APP=Terminal

# AI CLI used to diagnose failed updates (default: first found among claude, codex, gemini).
# Any command that takes the prompt as its last argument works; "none" removes the button.
# Only the output of the failed steps is sent, with personal data and known secrets masked,
# and you are asked first.
# AI_COMMAND="codex"

# Clean up Homebrew (old downloads and versions) after updating something with brew
# BREW_CLEANUP=no

# Sources to skip: macos brew mas apps node npm pnpm bun deno pipx uv cargo rustup gem mise
# tlmgr composer omz gh vscode
# SKIP=(gem pnpm)
