#!/bin/zsh
# check-updates — repère ce qui n'est pas à jour sur un Mac (système, applications,
# outils en ligne de commande), propose de choisir quoi mettre à jour et suit les erreurs.
# https://github.com/AntoineCAU/check-updates

VERSION=0.3.0
SELF="${0:a}"                          # chemin d'appel : le lien Homebrew reste valable d'une version à l'autre
LIB="${0:A:h:h}/libexec/check-updates" # fichiers réels, à côté du binaire résolu
T=$'\t'
zmodload zsh/datetime zsh/zselect

typeset -U path
path=(${PNPM_HOME:-$HOME/Library/pnpm} /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin $HOME/.local/bin $HOME/.cargo/bin $path /usr/bin /bin /usr/sbin /sbin)
export HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_AUTO_UPDATE=1

LABEL="io.github.antoinecau.check-updates"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/check-updates/config"
LOG_DIR="$HOME/Library/Logs/check-updates"
export CU_CACHE="$HOME/Library/Caches/check-updates"
ACTIONS="$LOG_DIR/actions.tsv"     # libellé <tab> commande, issus de la dernière vérification
SELECTION="$CU_CACHE/selection.tsv" # mises à jour cochées, exécutées par « __run »
IGNORED="${CONFIG:h}/ignored"       # « nom version » des mises à jour ignorées, une par ligne
NOTIFIER_APP="$HOME/Library/Application Support/check-updates/check-updates.app"

# Réglages par défaut, surchargés par le fichier de config
CHECK_HOUR=9 CHECK_MINUTE=30 TERMINAL_APP="" AI_COMMAND="" SKIP=() BREW_CLEANUP=yes
RESEAU_ESSAIS=60 RESEAU_PAUSE=30 # vérification programmée : jusqu'à 30 min d'attente du réseau
[[ -r "$CONFIG" ]] && source "$CONFIG"
mkdir -p "$LOG_DIR" "$CU_CACHE"

# Textes affichés, toujours en anglais
typeset -A M
source "$LIB/messages.zsh"
export LC_TIME="${M[locale]}"

m() { printf -- "${M[$1]}" "${@:2}" } # message, avec arguments printf
nb() { (( $1 == 1 )) && m ${2}_one || m ${2}_many $1 } # « 1 update » / « 7 updates »
helper() { /usr/bin/python3 -I "$LIB/helpers.py" "$@" }

# Fenêtre à boutons ; affiche le bouton cliqué (rien si elle reste sans réponse 4 h,
# pour ne pas bloquer la vérification du lendemain)
dialogue() { # titre, texte, boutons… (le dernier est celui par défaut)
  osascript "$LIB/dialog.applescript" "$@" 2>/dev/null &
  local pid=$!
  ( sleep 14400; kill $pid ) >/dev/null 2>&1 &! # sortie fermée : sinon $(dialogue …) attendrait le minuteur
  local minuteur=$!
  wait $pid
  kill $minuteur 2>/dev/null
}

# Notifications : affichées par une petite app construite sur ce Mac (notifier.applescript),
# pour qu'un clic fasse quelque chose d'utile ; sinon par osascript, dont le clic ouvre
# l'Éditeur de scripts
app_notifications() { # construit l'app si elle manque ou a changé ; code ≠ 0 si impossible
  local source="$LIB/notifier.applescript" copie="${NOTIFIER_APP:h}/notifier.applescript"
  [[ -d "$NOTIFIER_APP" ]] && cmp -s "$source" "$copie" && return 0
  rm -rf "$NOTIFIER_APP"
  mkdir -p "${NOTIFIER_APP:h}"
  osacompile -o "$NOTIFIER_APP" "$source" 2>/dev/null || return 1
  plutil -replace CFBundleIdentifier -string "$LABEL" "$NOTIFIER_APP/Contents/Info.plist" \
    && plutil -replace LSUIElement -bool true "$NOTIFIER_APP/Contents/Info.plist" \
    && codesign --force --sign - "$NOTIFIER_APP" 2>/dev/null \
    && cp "$source" "$copie"
}

notifier() { # titre, texte, [commande lancée par un clic sur la notification]
  if app_notifications; then
    print -rn -- "$3" > "$CU_CACHE/notification-click"
    print -r -- "$1"$'\n'"$2" > "$CU_CACHE/notification"
    open -n -g "$NOTIFIER_APP" 2>/dev/null && return
  fi
  osascript - "$1" "$2" <<'EOF' 2>/dev/null
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
EOF
}

# Une réponse HTTP de l'un de ces sites suffit à dire que le Mac est en ligne
en_ligne() {
  local url
  for url in https://formulae.brew.sh https://www.apple.com; do
    curl -sSI -o /dev/null --max-time 5 "$url" 2>/dev/null && return 0
  done
  return 1
}

# Hors ligne, toutes les sources échoueraient. Dans un terminal on le dit tout de suite ;
# sous launchd (souvent au réveil du Mac, avant que le Wi-Fi revienne) on attend le réseau
attendre_reseau() {
  en_ligne && return 0
  if [[ -t 1 ]]; then print -r -- "${M[offline]}" >&2; return 1; fi
  local i
  for i in {1..$RESEAU_ESSAIS}; do
    sleep $RESEAU_PAUSE
    en_ligne && return 0
  done
  print -r -- "$(date '+%F %T') ${M[offline_skipped]}"
  return 1
}

# CLI d'IA utilisée pour diagnostiquer un échec : celle de la config, sinon la première trouvée
ai_command() {
  [[ "$AI_COMMAND" == none ]] && return
  if [[ -n "$AI_COMMAND" ]]; then print -r -- "$AI_COMMAND"; return; fi
  (( $+commands[claude] )) && { print claude; return }
  (( $+commands[codex] )) && { print codex; return }
  (( $+commands[gemini] )) && { print "gemini -i"; return }
}

# ---------------------------------------------------------------------------
# Vérification
#
# Contrat d'une source (libexec/check-updates/sources/NN-nom.zsh) :
#   src_available  code 0 si l'outil est présent sur ce Mac
#   src_check      une ligne « libellé<tab>commande » par mise à jour, « #<tab>texte »
#                  pour une remarque ; code ≠ 0 si la vérification a échoué (outil en
#                  erreur, format de sortie inattendu…), plutôt que de se croire à jour
# ---------------------------------------------------------------------------

lancer_source() { # fichier, dossier → $2/out, $2/err, $2/code (99 si l'outil est absent)
  mkdir -p "$2"
  rm -f "$2/code"
  ( source "$1"; src_available || exit 99; src_check ) >"$2/out" 2>"$2/err"
  print -r -- $? > "$2/code.tmp" && mv "$2/code.tmp" "$2/code" # code présent = source terminée
}

nom_source() { print -r -- "${${1:t:r}#<->-}" }

ajouter_section() { # fichier source, code de retour, dossier → $d/section.md, $d/actions.tsv, $d/n
  local nom=$(nom_source "$1") code=$2 d=$3 lignes notes ligne n
  local -a gardees ignorees
  # Exactement deux champs, libellé et commande : rien d'autre ne passe
  lignes=$(grep -v "^#$T" "$d/out" | awk -F'\t' 'NF == 2 && $1 != "" && $2 != ""')
  notes=$(grep "^#$T" "$d/out" | cut -f2-)
  for ligne in "${(@f)lignes}"; do
    [[ -z "$ligne" ]] && continue
    if est_ignoree "${ligne%%$T*}"; then ignorees+=("${ligne%%$T*}"); else gardees+=("$ligne"); fi
  done
  n=$#gardees
  print -r -- $n > "$d/n"
  : > "$d/actions.tsv"
  {
    print "## ${M[title_$nom]:-$nom} ($n)\n"
    if (( n )); then
      print -rl -- "${gardees[@]%%$T*}" | sed 's/^/- /'
      print -rl -- "${gardees[@]}" > "$d/actions.tsv"
    elif (( code == 0 )); then
      print -r -- "${M[up_to_date]}"
    fi
    (( $#ignorees )) && print -rl -- "${ignorees[@]}" | sed "s/^/- ~~/; s/\$/~~ ${M[report_ignored]}/"
    [[ -n "$notes" ]] && print -r -- "$notes" | sed 's/^/> /'
    if (( code )); then
      print -r -- $'\n'"**⚠ $(m check_failed $code)**"$'\n\n```'; tail -n 8 "$d/err"; print '```'
    fi
    print
  } > "$d/section.md"
}

# Progression dans le terminal (rien sous launchd) : une ligne par source dès qu'elle a fini,
# et en dessous une ligne animée avec celles qui tournent encore
progression() { # nom, code, nombre de mises à jour
  [[ -t 1 ]] || return
  local nom="${(r:16:)1}"
  print -n $'\r\e[K'
  case $2 in
    99) ;;
    0) (( $3 )) && print -P -- "  %F{blue}●%f ${nom//\%/%%} $(nb $3 count)" \
                || print -P -- "  %F{green}✔%f ${nom//\%/%%} %F{8}${M[up_to_date_short]}%f" ;;
    *) print -P -- "  %F{red}✘%f ${nom//\%/%%} %F{red}${M[check_failed_short]}%f" ;;
  esac
}

attente() { # image de l'animation, noms des sources en cours
  [[ -t 1 ]] || return
  print -n -P -- $'\r\e[K'"  %F{8}$1 ${${(j:, :)@[2,-1]}//\%/%%}%f"
}

verifier() { # [quiet]
  if ! attendre_reseau; then [[ -t 1 ]] && return 1 || return 0; fi # sous launchd, pas un échec de l'outil
  RAPPORT="$LOG_DIR/$(date +%F).md"
  total=0 resume=() erreurs=()
  : > "$ACTIONS"
  print -r -- "# ${M[report_title]} — $(date '+%A %d %B %Y %H:%M')"$'\n' > "$RAPPORT"
  [[ -t 1 ]] && print -P -- "%B${M[checking]}%b"

  # Toutes les sources tournent en même temps ; chacune s'affiche dès qu'elle a fini
  local -a fichiers noms en_cours images=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local -A fini
  local f nom d i code tour=0
  for f in "$LIB"/sources/*.zsh(N); do
    nom=$(nom_source "$f")
    (( ${SKIP[(Ie)$nom]} )) && continue
    lancer_source "$f" "$CU_CACHE/sources/$nom" &
    fichiers+=("$f") noms+=("$nom")
  done
  while (( $#fini < $#fichiers )); do
    en_cours=()
    for i in {1..$#fichiers}; do
      [[ -n "${fini[$i]}" ]] && continue
      nom=$noms[$i] d="$CU_CACHE/sources/$nom"
      if [[ ! -f "$d/code" ]]; then en_cours+=("${M[title_$nom]:-$nom}"); continue; fi
      fini[$i]=1
      code=$(<"$d/code")
      (( code == 99 )) && { progression "" 99 0; continue }
      ajouter_section "$fichiers[$i]" $code "$d"
      progression "${M[title_$nom]:-$nom}" $code $(<"$d/n")
    done
    (( $#en_cours )) || break
    attente "${${M[still_checking]}/\%s/$images[tour % 10 + 1]}" "${en_cours[@]}"
    (( tour++ ))
    zselect -t 10 # 0,1 s
  done
  wait

  # Rapport et liste dans l'ordre des sources
  for i in {1..$#fichiers}; do
    nom=$noms[$i] d="$CU_CACHE/sources/$nom" code=$(<"$d/code")
    (( code == 99 )) && continue
    cat "$d/section.md" >> "$RAPPORT"
    cat "$d/actions.tsv" >> "$ACTIONS"
    (( $(<"$d/n") )) && resume+=("${M[title_$nom]:-$nom} $(<"$d/n")")
    (( total += $(<"$d/n") ))
    (( code )) && erreurs+=("${M[title_$nom]:-$nom}")
  done

  ln -sf "$RAPPORT" "$LOG_DIR/latest.md"
  print -l -- "${erreurs[@]}" > "$CU_CACHE/last_errors"
  find "$LOG_DIR" \( -name '20*.md' -mtime +30 -o -name 'run-*.log' -mtime +365 \) -delete # journaux : « history »

  local titre
  if (( total )); then titre=$(nb $total available)
  else titre=${M[all_good_title]}
  fi
  [[ -t 1 ]] && print
  print -r -- "$titre${erreurs:+ — $(m sources_failed "${(j:, :)erreurs}")}"
  [[ "$1" == quiet ]] && return

  if (( total )); then
    # Vérification programmée : la fenêtre ne s'ouvre que s'il y a du nouveau depuis la dernière liste
    if [[ ! -t 1 ]] && ! nouveautes; then
      notifier "$titre" "${M[nothing_new]}" "${(q)SELF} --list"
      return
    fi
    [[ -t 1 ]] && print -r -- "${M[opening_list]}"
    choisir
  elif (( $#erreurs )); then
    [[ $(dialogue "${M[check_incomplete]}" "$(m sources_failed "${(j:, :)erreurs}")"$'\n'"${M[doctor_hint]}" "${M[open_report]}" "${M[ok]}") == "${M[open_report]}" ]] \
      && open -t "$LOG_DIR/latest.md"
  else
    notifier "$titre" "${M[all_good]}"
  fi
}

# ---------------------------------------------------------------------------
# Choix des mises à jour puis exécution dans un terminal
#
# Une mise à jour dont la commande commence par « open » ne s'installe pas toute seule
# (macOS, app qui se met à jour elle-même, site de l'éditeur) : elle est rangée à part
# dans la fenêtre et simplement ouverte, sans passer par le terminal.
# ---------------------------------------------------------------------------

# Libellé d'une source → « nom<tab>détail » pour la liste : versions à droite, et les
# explications génériques (« opens the app… ») retirées, le titre du groupe les donne déjà
decouper() {
  local l=$1 note="" gauche nom detail=""
  if [[ "$l" == *" ("*")" ]]; then note=${${l##* \(}%\)} l=${l% \(*}; fi
  [[ "$note" == (${M[open_app]}|${M[open_site]}|${M[settings]}|cask) ]] && note=""
  if [[ "$l" == *" → "* ]]; then
    gauche=${l%% → *} nom=${gauche% *} detail="${gauche##* } → ${l#* → }"
  elif [[ "$l" == *" "* && ${l##* } == [0-9v]* ]]; then
    nom=${l% *} detail=${l##* }
  else
    nom=$l
  fi
  [[ -n "$note" ]] && detail+="${detail:+ · }$note"
  print -r -- "$nom$T$detail"
}

# Clé d'une mise à jour, « nom version-cible » : ignorer Docker 4.97.0 laisse revenir Docker 4.98
cle() {
  local champs=$(decouper "$1") detail
  detail=${${champs#*$T}%% · *}
  print -r -- "${champs%%$T*} ${detail##* }"
}

est_ignoree() { [[ -s "$IGNORED" ]] && grep -qxF -- "$(cle "$1")" "$IGNORED" }

ignorer() {
  local k=$(cle "$1")
  mkdir -p "${IGNORED:h}"
  grep -qxF -- "$k" "$IGNORED" 2>/dev/null || print -r -- "$k" >> "$IGNORED"
  [[ -t 1 ]] && m now_ignored "$k"
}

cles_actions() { local l c; while IFS=$T read -r l c; do cle "$l"; done < "$ACTIONS" }

nouveautes() { # vrai si une mise à jour n'était pas dans la dernière liste montrée
  [[ -s "$CU_CACHE/last_shown" ]] || return 0
  cles_actions | grep -qvxF -f "$CU_CACHE/last_shown"
}

majeure() { # libellé → vrai si la version majeure change (macOS : par rapport au système installé)
  local l=$1 de vers champs
  if [[ "$l" == *" → "* ]]; then
    de=${${l%% → *}##* } vers=${${l#* → }%% *}
  elif [[ "$l" == macOS\ * ]]; then
    champs=$(decouper "$l")
    de=$(sw_vers -productVersion) vers=${${champs#*$T}%% *}
  else
    return 1
  fi
  de=${${de#v}%%[^0-9]*} vers=${${vers#v}%%[^0-9]*}
  [[ -n "$de" && -n "$vers" ]] && (( vers > de ))
}

# security : seulement quand l'éditeur l'écrit (« Background Security Improvement »…) ;
# major : pour les mises à jour automatiques et macOS (les navigateurs changent de majeure chaque mois)
etiquette() { # libellé, commande
  if [[ "${1:l}" == *security* ]]; then print security
  elif [[ "$2" != open\ * || "$1" == macOS\ * ]] && majeure "$1"; then print major
  fi
}

choisir() {
  if [[ ! -s "$ACTIONS" ]]; then notifier check-updates "${M[nothing_pending]}"; return; fi
  local -a libelles commandes lignes ordre
  local l c i k tag ligne choix texte erreurs_connues automatiques=0
  while IFS=$T read -r l c; do libelles+=("$l") commandes+=("$c"); done < "$ACTIONS"
  # Les automatiques d'abord (case cochée, sauf version majeure), puis celles à faire
  # soi-même (bouton Open, qui reçoit sa commande) ; ordre[] renvoie à libelles[]
  for i in {1..$#libelles}; do
    [[ "$commandes[$i]" == open\ * ]] && continue
    tag=$(etiquette "$libelles[$i]" "$commandes[$i]")
    [[ "$tag" == major ]] && k=B || k=A
    ordre+=($i) lignes+=("$k$T$(decouper "$libelles[$i]")$T$tag")
    (( automatiques++ ))
  done
  for i in {1..$#libelles}; do
    [[ "$commandes[$i]" == open\ * ]] || continue
    ordre+=($i) lignes+=("M$T$(decouper "$libelles[$i]")$T$(etiquette "$libelles[$i]" "$commandes[$i]")$T$commandes[$i]")
  done

  (( automatiques )) && texte=${M[pick_hint]} || texte=${M[pick_hint_manual]}
  erreurs_connues=$(<"$CU_CACHE/last_errors" 2>/dev/null)
  [[ -n "$erreurs_connues" ]] && texte+=$'\n\n'"$(m sources_failed "${(pj:, :)${(f)erreurs_connues}}")"$'\n'"${M[doctor_hint]}"

  choix=$(osascript "$LIB/picker.applescript" "$(nb $#libelles available)" "$texte" \
    "${M[update_btn]}" "${M[later]}" "${M[done_btn]}" "${M[open_btn]}" "${M[opened]}" "${M[ignore_btn]}" "${M[ignored_btn]}" \
    "${M[group_auto]}" "${M[group_auto_hint]}" "${M[group_manual]}" "${M[group_manual_hint]}" "${lignes[@]}" 2>/dev/null)
  cles_actions > "$CU_CACHE/last_shown"

  # « u N » : à installer ; « i N » : à ignorer désormais
  : > "$SELECTION"
  for ligne in "${(@f)choix}"; do
    i=${ligne#* }
    case ${ligne%% *} in
      u) print -r -- "$libelles[$ordre[$i]]$T$commandes[$ordre[$i]]" >> "$SELECTION" ;;
      i) ignorer "$libelles[$ordre[$i]]" ;;
    esac
  done
  if [[ "$choix" == *i\ * ]]; then # retire tout de suite les ignorées de la liste
    while IFS=$T read -r l c; do est_ignoree "$l" || print -r -- "$l$T$c"; done < "$ACTIONS" > "$ACTIONS.tmp"
    mv "$ACTIONS.tmp" "$ACTIONS"
  fi
  if [[ ! -s "$SELECTION" ]]; then
    (( automatiques )) && [[ -t 1 ]] && print -r -- "${M[nothing_selected]}"
    return
  fi

  # Lancé depuis un terminal : les mises à jour s'y déroulent ; sinon (launchd) on en ouvre un
  if [[ -t 1 ]]; then executer; return; fi
  local script="$CU_CACHE/check-updates.command" app=$TERMINAL_APP
  print -r -- "#!/bin/zsh"$'\n'"exec ${(q)SELF} __run" > "$script"
  chmod +x "$script"
  [[ -z "$app" ]] && { [[ -d /Applications/iTerm.app ]] && app=iTerm || app=Terminal }
  open -a "$app" "$script"
}

executer() { # [window] : lancé dans un terminal ouvert exprès
  [[ -s "$SELECTION" ]] || return
  export ZSH="${ZSH:-$HOME/.oh-my-zsh}" NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

  local journal="$LOG_DIR/run-$(date +%F-%H%M%S).log" sortie="$CU_CACHE/step.out"
  local -a reussies echecs
  local -A deja
  local l c code details="" brew_mis_a_jour=0 nettoyage liberee
  while IFS=$T read -r l c <&3; do
    [[ -n "${deja[$c]}" ]] && continue
    deja[$c]=1
    print -P -- $'\n'"%B▶ ${l//\%/%%}%b"
    print -r -- "▶ $l"$'\n'"\$ $c" >> "$journal"
    # nvm use default : une étape précédente a pu changer la version de Node par défaut
    { (( $+functions[nvm] )) && nvm use default --silent >/dev/null 2>&1; eval "$c" } 2>&1 | tee "$sortie"
    code=${pipestatus[1]}
    cat "$sortie" >> "$journal"
    print -r -- "→ code $code"$'\n' >> "$journal"
    if (( code == 0 )); then
      reussies+=("$l")
      [[ "$c" == brew\ * ]] && brew_mis_a_jour=1
      print -P -- "%F{green}✔ ${M[step_ok]}%f"
    else
      echecs+=("$l")
      print -P -- "%F{red}✘ $(m step_failed $code)%f"
      details+="### $l"$'\n'"\$ $c"$'\n'"$(tail -n 60 "$sortie")"$'\n\n'
    fi
  done 3< "$SELECTION"
  rm -f "$SELECTION"

  # Homebrew garde les téléchargements et parfois d'anciennes versions : on fait le ménage
  if (( brew_mis_a_jour )) && [[ "$BREW_CLEANUP" != no ]]; then
    print -P -- $'\n'"%B${M[cleaning]}%b"
    nettoyage=$(brew cleanup 2>&1)
    print -r -- "· brew cleanup"$'\n'"$nettoyage"$'\n' >> "$journal"
    # « This operation has freed approximately 1.2GB of disk space. »
    liberee=$(print -r -- "$nettoyage" | sed -nE 's/.*freed approximately ([0-9.]+ ?[KMGT]?B).*/\1/p' | tail -1)
    if [[ -n "$liberee" ]]; then print -P -- "%F{green}✔ $(m cleanup_freed "$liberee")%f"
    else print -P -- "%F{green}✔ ${M[cleanup_nothing]}%f"
    fi
  fi

  print -P -- $'\n'"%B${M[rechecking]}%b"
  "$SELF" --quiet

  if (( ! $#echecs )); then
    print -P -- $'\n'"%F{green}$(m run_all_ok $#reussies)%f"
    notifier check-updates "$(m run_all_ok $#reussies)"
  else
    print -P -- $'\n'"%F{red}$(m run_some_failed $#reussies $#echecs)%f"
    local ia=$(ai_command) rep
    local -a boutons=("${M[close]}" "${M[open_log]}")
    [[ -n "$ia" ]] && boutons+=("$(m ask_ai ${ia%% *})")
    rep=$(dialogue "$(m run_some_failed $#reussies $#echecs)" "• ${(pj:\n• :)echecs}" "${boutons[@]}")
    case "$rep" in
      "${M[open_log]}") open -t "$journal" ;;
      "${M[close]}"|"") ;;
      *) diagnostiquer_ia "$ia" "$details" ;;
    esac
  fi
  [[ "$1" == window ]] && print -r -- $'\n'"${M[done]}"
}

lister_ignorees() {
  if [[ -s "$IGNORED" ]]; then print -r -- "${M[ignored_title]}"; sed 's/^/  /' "$IGNORED"
  else print -r -- "${M[ignored_none]}"
  fi
}

designorer() { # nom | --all
  case "$1" in
    "") m unignore_usage >&2; return 2 ;;
    --all) rm -f "$IGNORED"; print -r -- "${M[unignored_all]}" ;;
    *) [[ -f "$IGNORED" ]] || return 0
       awk -v n="$1" 'tolower(substr($0, 1, length(n) + 1)) != tolower(n " ")' "$IGNORED" > "$IGNORED.tmp"
       mv "$IGNORED.tmp" "$IGNORED"
       m unignored "$1" ;;
  esac
}

# Ce qui a été installé et quand, d'après les journaux des mises à jour (gardés un an) :
# « ▶ libellé » au début de chaque étape, « → code N » à la fin
historique() { # [nombre de passages | --all]
  local n=${1:-10} f l ligne date
  [[ "$n" == --all ]] && n=100000
  [[ "$n" == <1-> ]] || { m history_usage >&2; return 2 }
  local -a journaux=("$LOG_DIR"/run-*.log(NOn[1,$n]))
  if (( ! $#journaux )); then print -r -- "${M[history_none]}"; return; fi
  for f in "${journaux[@]}"; do
    date=${${f:t:r}#run-} # 2026-11-02-140312
    print -P -- "%B${date[1,10]} ${date[12,13]}:${date[14,15]}%b"
    while IFS= read -r ligne; do
      case "$ligne" in
        "▶ "*) l=${ligne#▶ } ;;
        "→ code 0") print -P -- "  %F{green}✔%f ${l//\%/%%}" ;;
        "→ code "<->) print -P -- "  %F{red}✘%f ${l//\%/%%} %F{8}$(m step_failed ${ligne#→ code })%f" ;;
      esac
    done < "$f"
    print
  done
  m history_logs "${LOG_DIR/#$HOME/~}"
}

# Diagnostic d'un échec par une CLI d'IA. Seule la sortie des étapes en échec part, après
# masquage du dossier personnel, des noms d'utilisateur et de machine et des secrets
# reconnaissables ; une fenêtre dit ce qui est envoyé et permet de le relire avant
diagnostiquer_ia() { # commande de l'IA, sortie des étapes en échec
  local ia=$1 nom=${1%% *} envoi="$CU_CACHE/ai-report.txt" rep
  print -r -- "$2" | helper redact > "$envoi" || return
  while true; do
    rep=$(dialogue "$(m ai_confirm_title $nom)" "$(m ai_confirm_text $nom)" "${M[ai_show]}" "${M[cancel]}" "${M[ai_send]}")
    case "$rep" in
      "${M[ai_show]}") open -t "$envoi" ;;
      "${M[ai_send]}") break ;;
      *) return ;;
    esac
  done
  eval "$ia ${(q)$(m ai_prompt "$(sw_vers -productVersion)" "$(<"$envoi")")}"
}

# ---------------------------------------------------------------------------
# Vérification quotidienne : désactivée tant qu'on ne lance pas « schedule on »
# ---------------------------------------------------------------------------

programmer() { # on [HH:MM] | off | rien (affiche l'état)
  case "$1" in
    on) [[ -z "$2" ]] || regler_heure "$2" || return 2; activer ;;
    off) desactiver ;;
    "") if [[ -f "$PLIST" ]]; then m schedule_on $CHECK_HOUR $CHECK_MINUTE; else print -r -- "${M[schedule_off]}"; fi ;;
    *) m unknown_cmd "schedule $1" >&2; return 2 ;;
  esac
}

regler_heure() { # HH:MM → CHECK_HOUR / CHECK_MINUTE, enregistrés dans la config
  if [[ ! "$1" =~ '^([01]?[0-9]|2[0-3]):[0-5][0-9]$' ]]; then
    m bad_time "$1" >&2
    return 1
  fi
  CHECK_HOUR=$(( 10#${1%%:*} )) CHECK_MINUTE=$(( 10#${1##*:} ))
  mkdir -p "${CONFIG:h}"
  [[ -f "$CONFIG" ]] || cp "$LIB/config.example" "$CONFIG"
  sed -i '' -e '/^CHECK_HOUR=/d' -e '/^CHECK_MINUTE=/d' "$CONFIG"
  print -r -- "CHECK_HOUR=$CHECK_HOUR"$'\n'"CHECK_MINUTE=$CHECK_MINUTE" >> "$CONFIG"
}

activer() {
  mkdir -p "${PLIST:h}" "${CONFIG:h}"
  [[ -f "$CONFIG" ]] || cp "$LIB/config.example" "$CONFIG"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>$SELF</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>$CHECK_HOUR</integer>
		<key>Minute</key>
		<integer>$CHECK_MINUTE</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>$LOG_DIR/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>$LOG_DIR/launchd.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  launchctl bootstrap "gui/$UID" "$PLIST" && m installed $CHECK_HOUR $CHECK_MINUTE
}

desactiver() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  rm -f "$PLIST"
  m uninstalled
}

# ---------------------------------------------------------------------------
# Diagnostic : vérifie que chaque brique fonctionne encore sur ce Mac
# (après une mise à jour de macOS, de Homebrew ou d'un gestionnaire de paquets)
# ---------------------------------------------------------------------------

diagnostiquer() {
  local ko=0 f nom code debut n
  etat() { # ok|warn|ko|off, texte
    case $1 in
      ok) print -P -- "  %F{green}✔%f $2" ;;
      warn) print -P -- "  %F{yellow}!%f $2" ;;
      off) print -P -- "  %F{8}–%f $2" ;;
      *) print -P -- "  %F{red}✘%f $2"; ko=1 ;;
    esac
  }

  print -P -- "%Bcheck-updates $VERSION%b — macOS $(sw_vers -productVersion), zsh $ZSH_VERSION${commands[brew]:+, $(brew --version 2>/dev/null | head -1)}"

  print -P -- $'\n'"%B${M[doctor_env]}%b"
  if /usr/bin/python3 -I -c 'import json, plistlib, urllib.request, xml.etree.ElementTree' 2>/dev/null; then
    etat ok "$(/usr/bin/python3 --version 2>&1)"
  else
    etat ko "python3 — xcode-select --install"
  fi
  if osacompile -o "$CU_CACHE/picker.scpt" "$LIB/picker.applescript" 2>"$CU_CACHE/source.err" \
    && osacompile -o "$CU_CACHE/dialog.scpt" "$LIB/dialog.applescript" 2>>"$CU_CACHE/source.err"; then
    etat ok "${M[doctor_picker]}"
  else
    etat ko "${M[doctor_picker]} : $(tail -1 "$CU_CACHE/source.err")"
  fi
  if app_notifications && plutil -lint "$NOTIFIER_APP/Contents/Info.plist" >/dev/null; then
    etat ok "${M[doctor_notifier]}"
  else
    etat warn "${M[doctor_notifier]} — ${M[doctor_notifier_ko]}"
  fi
  if en_ligne; then etat ok "${M[doctor_network]}"; else etat ko "${M[doctor_network]} — ${M[doctor_offline]}"; fi
  if helper selftest >/dev/null 2>"$CU_CACHE/source.err"; then
    etat ok "${M[doctor_catalog]}"
  else
    etat ko "${M[doctor_catalog]} : $(tail -1 "$CU_CACHE/source.err")"
  fi

  print -P -- $'\n'"%B${M[doctor_sources]}%b"
  for f in "$LIB"/sources/*.zsh(N); do
    nom=$(nom_source "$f")
    if (( ${SKIP[(Ie)$nom]} )); then etat off "${M[title_$nom]:-$nom} — ${M[doctor_skipped]}"; continue; fi
    debut=$EPOCHREALTIME
    lancer_source "$f" "$CU_CACHE/sources/$nom"; code=$(<"$CU_CACHE/sources/$nom/code")
    n=$(grep -v "^#$T" "$CU_CACHE/sources/$nom/out" | grep -c "$T")
    case $code in
      99) etat off "${M[title_$nom]:-$nom} — ${M[doctor_absent]}" ;;
      0) etat ok "${M[title_$nom]:-$nom} — $(nb $n count) ($(printf %.1f $(( EPOCHREALTIME - debut )))s)" ;;
      *) etat ko "${M[title_$nom]:-$nom} — code $code"
         tail -n 4 "$CU_CACHE/sources/$nom/err" | sed 's/^/      /' ;;
    esac
  done

  print -P -- $'\n'"%B${M[doctor_schedule]}%b"
  if [[ -f "$PLIST" ]] && launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; then
    local dernier=$(launchctl print "gui/$UID/$LABEL" | sed -n 's/.*last exit code = //p' | head -1)
    if [[ "$dernier" == 0 || "$dernier" == *never* || -z "$dernier" ]]; then
      etat ok "$(m doctor_agent_ok $CHECK_HOUR $CHECK_MINUTE)"
    else
      etat ko "$(m doctor_agent_ko "$dernier" "$LOG_DIR/launchd.log")"
    fi
  else
    etat warn "${M[doctor_not_installed]}"
  fi
  local ia=$(ai_command)
  [[ -n "$ia" ]] && etat ok "$(m doctor_ai "$ia")" || etat off "${M[doctor_no_ai]}"

  print
  if (( ko )); then print -P -- "%F{red}${M[doctor_ko]}%f"; else print -P -- "%F{green}${M[doctor_ok]}%f"; fi
  return $ko
}

# Chargé avec « source » (tests) : seulement les fonctions
[[ "$ZSH_EVAL_CONTEXT" == *:file* ]] && return 0

case "$1" in
  "") verifier ;;
  --quiet) verifier quiet ;;
  --list) choisir ;;
  __run) executer window ;;
  doctor) diagnostiquer ;;
  schedule) programmer "$2" "$3" ;;
  ignored) lister_ignorees ;;
  unignore) designorer "$2" ;;
  history) historique "$2" ;;
  install) programmer on ;;    # ancien nom (0.1.x)
  uninstall) programmer off ;; # ancien nom (0.1.x)
  -v|--version) print -r -- "check-updates $VERSION" ;;
  -h|--help|help) print -r -- "${M[help]}" ;;
  *) m unknown_cmd "$1" >&2; exit 2 ;;
esac
